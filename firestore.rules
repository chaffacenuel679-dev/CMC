rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function profil() { return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data; }
    function estAdmin() { return connecte() && profil().role == 'admin'; }
    // Identifiant du bulletin du 1er semestre de l'élève connecté pour une année donnée
    function monBulletinS1(annee) { return request.auth.uid + '_' + annee + '_S1'; }

    // Profils : chacun lit le sien, l'admin lit tout
    // Le rôle d'un compte ne peut pas être changé, et un compte n'est jamais supprimé
    // (les anciens élèves gardent l'accès à leurs bulletins)
    match /utilisateurs/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow create: if estAdmin() && request.resource.data.role in ['eleve', 'admin'];
      allow update: if estAdmin() && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Bulletins : un élève lit les siens ; lire un bulletin qui n'existe pas encore n'est pas refusé
    match /bulletins/{id} {
      allow read: if connecte() && (estAdmin() || resource == null || resource.data.eleve_id == request.auth.uid);
      allow create, delete: if estAdmin();
      allow update: if estAdmin() && (resource.data.get('cloture', false) != true
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expire_le']));
    }

    // Classements : lisibles seulement par les élèves de cette classe CETTE année-là :
    // - inscrits au classement (eleves_uids) ;
    // - ou élève actif de la classe pendant l'année active (arrivé après la clôture du 1er semestre) ;
    // - ou dont le bulletin du 1er semestre de cette année porte cette classe (classements anciens).
    // Un élève ne voit donc ni les promotions précédentes de sa classe, ni, après son départ, la nouvelle promotion.
    match /statistiques_classe/{id} {
      allow read: if connecte() && (estAdmin() || resource == null
                  || request.auth.uid in resource.data.get('eleves_uids', [])
                  || (profil().get('statut', 'actif') != 'inactif'
                      && profil().get('classe', '') == resource.data.classe
                      && resource.data.get('annee_scolaire', '') == get(/databases/$(database)/documents/config/annee_active).data.valeur)
                  || get(/databases/$(database)/documents/bulletins/$(monBulletinS1(resource.data.annee_scolaire))).data.classe == resource.data.classe);
      allow write: if estAdmin();
    }

    match /corbeille/{id} { allow read, write: if estAdmin(); }

    match /config/{id} {
      allow read: if connecte();
      allow write: if estAdmin();
    }
  }
}
