rules_version = '2';
// Règles Firestore du portail des résultats du CMC
// - Administrateur : peut tout lire et tout écrire (inscrire, noter, clôturer, passage d'année, archives).
// - Élève / parents : lecture seule de son compte, de l'année active, de SES bulletins et des classements.
// - Personne d'autre : aucun accès.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    // Le rôle est lu dans le profil de la personne connectée (utilisateurs/{son uid})
    function estAdmin() {
      return connecte()
        && get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role == "admin";
    }

    // Comptes (élèves et administrateurs)
    match /utilisateurs/{uid} {
      allow get: if connecte() && (request.auth.uid == uid || estAdmin());
      allow list: if estAdmin();
      allow create: if estAdmin()
        && request.resource.data.role in ["eleve", "admin"]
        && request.resource.data.nom is string;
      // Un administrateur peut changer la classe, le statut, l'historique… mais pas le rôle
      allow update: if estAdmin()
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Année scolaire active et années archivées
    match /config/{docId} {
      allow read: if connecte();
      allow write: if estAdmin();
    }

    // Bulletins : identifiant = {uid de l'élève}_{année}_{S1|S2|ANNUEL}
    match /bulletins/{bulletinId} {
      allow get: if (connecte() && bulletinId.matches(request.auth.uid + "_.*")) || estAdmin();
      allow list: if estAdmin();
      allow write: if estAdmin();
    }

    // Moyennes et classements de classe (visibles par les familles connectées)
    match /statistiques_classe/{statId} {
      allow read: if connecte();
      allow write: if estAdmin();
    }

    // Corbeille des archives
    match /corbeille/{id} {
      allow read, write: if estAdmin();
    }
  }
}
